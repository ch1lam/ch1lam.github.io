---
// Keep the existing environment names and og:title mapping so discussions survive.
const { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY_ID, GISCUS_lang } =
  import.meta.env;
const enabled = GISCUS_REPO && GISCUS_REPO_ID && GISCUS_CATEGORY_ID;
---

{enabled && (
  <section
    class="giscus mt-10 w-full"
    aria-label="评论"
    data-pagefind-ignore
    data-repo={GISCUS_REPO}
    data-repo-id={GISCUS_REPO_ID}
    data-category-id={GISCUS_CATEGORY_ID}
    data-lang={GISCUS_lang || "zh-CN"}
  />
)}

<script>
  let observer: MutationObserver | undefined;

  function currentTheme() {
    return document.documentElement.dataset.theme === "dark"
      ? "dark_dimmed"
      : "light";
  }

  function mountComments() {
    observer?.disconnect();
    const container = document.querySelector<HTMLElement>(".giscus");
    if (!container || container.querySelector("script")) return;

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    const options = {
      repo: container.dataset.repo!,
      "repo-id": container.dataset.repoId!,
      category: "Announcements",
      "category-id": container.dataset.categoryId!,
      mapping: "og:title",
      strict: "0",
      "reactions-enabled": "0",
      "emit-metadata": "0",
      "input-position": "top",
      theme: currentTheme(),
      lang: container.dataset.lang!,
      loading: "lazy",
    };
    for (const [key, value] of Object.entries(options)) {
      script.setAttribute(`data-${key}`, value);
    }
    script.crossOrigin = "anonymous";
    script.async = true;
    container.appendChild(script);

    observer = new MutationObserver(() => {
      container
        .querySelector<HTMLIFrameElement>("iframe.giscus-frame")
        ?.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: currentTheme() } } },
          "https://giscus.app"
        );
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  document.addEventListener("astro:page-load", mountComments);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>
